# ═══════════════════════════════════════════════════════════════════════
#  Тағйирёбандаҳои муҳити TajikShop API
# ═══════════════════════════════════════════════════════════════════════
#
# Ин ФАЙЛИ НАМУНА аст. Арзиши ҳақиқиро ин ҷо НАНАВИСЕД — он ба git
# меафтад ва абадӣ дар таърих мемонад, ҳатто агар баъд нест кунед.
#
# Арзишҳои ҳақиқӣ дар Hugging Face Space → Settings → Variables and
# secrets гузошта мешаванд.
#
# Ҳар сатри «ҲАТМӢ» — бе он сервер ё аз кор меафтад, ё бахши он кор
# намекунад.

# ── Сервер ────────────────────────────────────────────────────────────
PORT=8080

# ── Базаи додаҳо (ҲАТМӢ) ──────────────────────────────────────────────
# ⚠️ Ном маҳз `DB_URL` аст, на `DATABASE_URL` — ман худам аввал
# нодуруст навиштам. Бо номи нодуруст сервер бо `mustEnv` аз кор меафтад.
# Бе он сервер оғоз намешавад (`log.Fatalf`).
DB_URL=postgres://user:pass@host:5432/dbname?sslmode=require

# ── JWT (ҲАТМӢ) ───────────────────────────────────────────────────────
# Сатри тасодуфии дарози 32+ ҳарф. Иваз кардани он ҲАМАИ корбаронро
# аз ҳисоб мебарорад (ҳамаи токенҳо беэътибор мешаванд).
JWT_SECRET=

# ── Cloudflare R2 (расмҳо) ────────────────────────────────────────────
# Бе инҳо боркунии расм кор намекунад, вале сервер оғоз мешавад.
#
# Калидҳо мӯҳлат доранд. Сервер ҳангоми оғоз онҳоро ВОҚЕАН месанҷад
# (`HeadBucket`) ва дар лог менависад — пас калиди мӯҳлаташ гузашта
# фавран маълум мешавад, на дар лаҳзаи аввалин боркунӣ.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=tajikshop
# Бе ин линки расмҳо нопурра мешавад.
R2_PUBLIC_URL=https://<your-public-bucket-url>

# ── Firebase (push) ───────────────────────────────────────────────────
# Ду роҳ, яке аз онҳо кифоя:
#
#   1) тамоми JSON-и service account дар ЯК сатр — барои HF Space
#      мувофиқтар, чунки он файл қабул намекунад;
#   2) роҳи файли .json дар диск.
#
# Бе ҳарду push кор намекунад, вале сервер оғоз мешавад.
FIREBASE_SERVICE_ACCOUNT=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Почтаи электронӣ (SMTP) ───────────────────────────────────────────
# Бе инҳо фиристодани почта ХОМӮШ аст (огоҳии админ, тасдиқи почта).
# Сервер дар ҳар ҳол оғоз мешавад.
#
# Барои Gmail: `SMTP_PASS` пароли оддӣ НЕСТ — он «App Password»-и
# 16-рақама аст, ки дар танзимоти ҳисоби Google сохта мешавад. Бо
# пароли оддӣ Gmail дархостро рад мекунад.
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=
# Гирандаи огоҳиҳои админ.
ADMIN_EMAIL=

# ── SSO бо Raonson ────────────────────────────────────────────────────
# Калиди муштарак бо Raonson. ДАР ҲАР ДУ БАРНОМА ЯК ХЕЛ бошад.
#
# Агар холӣ монад, санҷиши калид ХОМӮШ мешавад — яъне ҳар кас метавонад
# кодро иваз кунад. Дар production ҳатман гузоред.
SSO_PARTNER_KEY=

# ── Пардохт ───────────────────────────────────────────────────────────
# Холӣ = пардохти онлайн ХОМӮШ, ва ҳамаи масирҳои он 503 медиҳанд.
#
# Ин қасдан чунин аст: «провайдери қалбакӣ, ки ҳамеша мегӯяд пардохт
# шуд» дар production моли ройгон медод.
#
#   sandbox — провайдери ТЕСТӢ (на пули воқеӣ)
#   alif / korti-milli — ҳанӯз сохта нашудаанд, маълумоти merchant лозим
PAYMENT_PROVIDER=
# Калиди имзои webhook. Бе он ҳар кас метавонад «пардохт шуд» фиристад.
PAYMENT_WEBHOOK_SECRET=

# ── Тестҳо (танҳо дар CI/маҳаллӣ) ─────────────────────────────────────
# Базаи ҶУДОИ тестӣ. ҲЕҶ ГОҲ базаи production-ро ин ҷо нанависед —
# тестҳо дар он сатр месозанд ва нест мекунанд.
#
# Агар холӣ бошад, тестҳои база skip мешаванд ва `go test ./...` сабз
# мемонад.
# TAJIKSHOP_TEST_DB_URL=postgres://postgres@127.0.0.1:5432/tajikshop_test?sslmode=disable
